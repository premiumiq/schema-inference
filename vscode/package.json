{
  "name": "schema-inference-vscode",
  "displayName": "Schema Inference",
  "description": "Inline column mapping annotations, an accept/reject review panel, and dbt staging model scaffolding for the schema_inference tool -- driven by a JSON-RPC bridge to the Python pipeline.",
  "version": "0.0.1",
  "private": true,
  "publisher": "premiumiq",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/premiumiq/schema-inference.git",
    "directory": "vscode"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "dbt",
    "schema mapping",
    "data engineering",
    "insurance"
  ],
  "icon": "icon.png",
  "activationEvents": [
    "workspaceContains:**/schema_inference/agent_config.yml"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "schemaInference.profileAndMap",
        "title": "Schema Inference: Profile & Map Current File"
      },
      {
        "command": "schemaInference.restartBridge",
        "title": "Schema Inference: Restart Bridge Process"
      },
      {
        "command": "schemaInference.openReviewPanel",
        "title": "Schema Inference: Open Review Panel"
      },
      {
        "command": "schemaInference.refreshHealthSidebar",
        "title": "Schema Inference: Refresh Mapping Health",
        "icon": "$(refresh)"
      },
      {
        "command": "schemaInference.openTuningPanel",
        "title": "Schema Inference: Open Self-Tuning Panel"
      },
      {
        "command": "schemaInference.profileSnowflakeTable",
        "title": "Schema Inference: Profile Snowflake Table"
      },
      {
        "command": "schemaInference.extractTargetSchema",
        "title": "Schema Inference: Extract Target Schema from Snowflake Table"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "schemaInferenceHealth",
          "name": "Schema Inference: Mapping Health"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "schemaInference.refreshHealthSidebar",
          "when": "view == schemaInferenceHealth",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Schema Inference",
      "properties": {
        "schemaInference.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Path to the Python interpreter with schema_inference installed (pip install -e \".[dev]\"). Leave blank to auto-detect."
        },
        "schemaInference.sourceName": {
          "type": "string",
          "default": "",
          "description": "Logical source name passed to profile/map (e.g. pasl, pasm). Prompted if unset."
        },
        "schemaInference.snowflakeDatabase": {
          "type": "string",
          "default": "",
          "description": "Default Snowflake database to prefill in \"Profile Snowflake Table\". Requires SNOWFLAKE_* credentials as real environment variables in the process VS Code runs in (not just present in .env -- nothing in this extension or the Python pipeline loads .env)."
        },
        "schemaInference.snowflakeSchema": {
          "type": "string",
          "default": "",
          "description": "Default Snowflake schema to prefill in \"Profile Snowflake Table\"."
        }
      }
    }
  },
  "scripts": {
    "check-types": "tsc --noEmit -p ./",
    "compile": "npm run check-types && node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "npm run check-types && node esbuild.js --production",
    "vscode:prepublish": "npm run package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.4.0"
  }
}
