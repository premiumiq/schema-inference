ANTHROPIC_API_KEY=sk-ant-...

# Snowflake (only needed for --snowflake profiling mode)
SNOWFLAKE_ACCOUNT=orgname-accountname
SNOWFLAKE_USER=SVC_DBT_DEV
SNOWFLAKE_PRIVATE_KEY_PATH=/path/to/key.p8
SNOWFLAKE_DATABASE=DEV_INSURANCE_DB
SNOWFLAKE_WAREHOUSE=DEV_WH
SNOWFLAKE_ROLE=DEV-INSURANCE-PRODUCER

# Override the default ground truth catalog directory (examples/insurance/ground_truth)
# Set this to point at another domain's catalogs without modifying code.
SCHEMA_INFERENCE_CATALOG_DIR=

# Set to "1" to bypass the process-wide rate limiter (useful in dev/test)
SCHEMA_INFERENCE_DISABLE_THROTTLE=
